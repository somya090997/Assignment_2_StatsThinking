aic_table <- data.frame(
Distribution = c(
"Gamma",
"Exponential",
"Weibull"
),
AIC = c(
AIC(gamma_fit),
AIC(exponential_fit),
AIC(weibull_fit)
)
)
aic_table |>
gt() |>
tab_header(
title = "Comparison of Fitted Distributions",
subtitle = "Akaike Information Criterion (AIC)"
) |>
cols_label(
Distribution = "Distribution",
AIC = "AIC Value"
) |>
fmt_number(
columns = AIC,
decimals = 3
) |>
tab_style(
style = cell_text(weight = "bold"),
locations = cells_body(
columns = AIC,
rows = AIC == min(AIC)
)
) |>
tab_source_note(
source_note = "Lower AIC values indicate a better relative model fit."
)
View(aic_table)
