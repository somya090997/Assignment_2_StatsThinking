library(tidyverse)
movies <- read.csv("data/movies.csv", stringsAsFactors = FALSE)
target_genres <- c("Action", "Comedy", "Drama", "Horror", "Animation")
movies_5 <- movies |>
filter(primary_genre %in% target_genres)
movies_clean <- movies_5 |>
mutate(
# Replace placeholder budgets with NA instead of dropping rows
budget   = if_else(budget == 0 | budget < 10000, NA_real_, budget),
# Replace placeholder revenue with NA instead of dropping rows
revenue  = if_else(revenue == 0, NA_real_, revenue),
# Recalculate ROI — will be NA where budget or revenue is NA
roi      = revenue / budget,
budget_m = budget / 1e6,
franchise_status =
)
