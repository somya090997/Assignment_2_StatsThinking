results_table <- data.frame(
Method = c(
"Non-parametric bootstrap",
"Normal parametric bootstrap"
),
`Estimated 25th Percentile` = c(
as.numeric(q25),
as.numeric(q25_normal)
),
`Lower 95% CI` = c(
as.numeric(bootstrap_CI[1]),
as.numeric(parametric_CI[1])
),
`Upper 95% CI` = c(
as.numeric(bootstrap_CI[2]),
as.numeric(parametric_CI[2])
),
check.names = FALSE
)
results_table |>
gt() |>
tab_header(
title = "Action Film ROI: Downside Risk",
subtitle = "Comparison of 25th Percentile Estimates"
) |>
fmt_number(
columns = -Method,
decimals = 4
) |>
cols_label(
Method = "Estimation Method",
`Estimated 25th Percentile` = "25th Percentile",
`Lower 95% CI` = "Lower 95% CI",
`Upper 95% CI` = "Upper 95% CI"
) |>
tab_source_note(
source_note = "Confidence intervals are based on 10,000 bootstrap resamples."
)
