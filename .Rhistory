assignment_data<-read.csv("data/movies.csv")
library(dplyr)
library(tidyverse)
glimpse(assignment_data)
Universal_budget<- assignment_data |>
filter(primary_company == "Universal Pictures") |>
select(title, id, status, primary_genre, budget) |>
mutate(budget = as.double(budget))
Universal_budget|>
summarise(
n= n(),
mean_budget= mean(budget),
median_budget = median(budget),
sd_budget= sd(budget)
)
library(MASS)
library(ggplot2)
normal_fit <- fitdistr(
Universal_budget$budget,
"normal"
)
normal_fit
ggplot(Universal_budget, aes(x = budget)) +
geom_histogram(
aes(y = after_stat(density)),
bins = 30,
fill = "skyblue",
colour = "black"
) +
stat_function(
fun = dnorm,
args = list(
mean = mean(Universal_budget$budget, na.rm= TRUE),
sd= sd(Universal_budget$budget, na.rm= TRUE)
),
colour = "brown",
linewidth = 1.2
) +
geom_vline(
xintercept = mean(Universal_budget$budget, na.rm = TRUE),
colour = "darkblue",
linetype = "dashed",
linewidth = 1
) +
labs(
title = "Universal Pictures Production Budgets",
subtitle = "Histogram with fitted normal distribution",
x = "Production Budget (USD)",
y = "Density"
) +
theme_minimal()
#making the log transformation to see the distribution
Universal_budget <- Universal_budget |>
filter(
!is.na(budget),
is.finite(budget),
budget > 0
) |>
mutate(log_budget = log(budget))
Universal_budget <- Universal_budget |>
filter(
!is.na(budget),
is.finite(budget),
budget > 0
) |>
mutate(log_budget = log(budget))
ggplot(Universal_budget, aes(x = log_budget)) +
geom_histogram(
aes(y = after_stat(density)),
bins = 30,
fill = "skyblue",
colour = "black"
) +
stat_function(
fun = dnorm,
args = list(
mean = mean(Universal_budget$log_budget, na.rm = TRUE),
sd   = sd(Universal_budget$log_budget, na.rm = TRUE)
),
colour = "brown",
linewidth = 1.2
) +
geom_vline(
xintercept = mean(Universal_budget$log_budget, na.rm = TRUE),
colour = "darkblue",
linetype = "dashed",
linewidth = 1
) +
labs(
title = "Log-Transformed Universal Pictures Budgets",
subtitle = "Histogram of natural logarithm of production budgets",
x = "Log of Production Budget",
y = "Density"
) +
theme_minimal()
#QQ plot of log-transformed data
ggplot(Universal_budget, aes(sample = log_budget)) +
stat_qq() +
stat_qq_line(colour = "red") +
labs(
title = "Q-Q Plot of Log-Transformed Budgets",
x = "Theoretical Quantiles",
y = "Sample Quantiles"
) +
theme_minimal()
#QQ plot of non-tranformed data.
ggplot(Universal_budget, aes(sample = budget)) +
stat_qq() +
stat_qq_line(colour = "red") +
labs(
title = "Q-Q Plot of Universal Pictures Production Budgets",
subtitle = "Original budgets without log transformation",
x = "Theoretical Quantiles",
y = "Sample Quantiles"
) +
theme_minimal()
#trying to fit the
Universal_budget_clean <- Universal_budget |>
filter(
!is.na(budget),
is.finite(budget),
budget > 0
) |>
mutate(budget_millions = budget / 10000000)
budget_values <- Universal_budget_clean$budget_millions
gamma_fit <- fitdistr(
budget_values,
"gamma",
start = list(
shape = mean(budget_values)^2 / var(budget_values),
rate  = mean(budget_values)   / var(budget_values)
),
lower = c(0.001, 0.001)
)
gamma_fit
library(ggplot2)
ggplot(data.frame(budget_values = budget_values),
aes(x = budget_values)) +
# Histogram of production budgets
geom_histogram(
aes(y = after_stat(density)),
bins = 30,
fill = "skyblue",
colour = "black"
) +
# Fitted Gamma distribution
stat_function(
fun = dgamma,
args = list(
shape = gamma_fit$estimate["shape"],
rate = gamma_fit$estimate["rate"]
),
colour = "red",
linewidth = 1.2
) +
labs(
title = "Universal Pictures Production Budgets",
subtitle = "Histogram with fitted Gamma distribution",
x = "Production Budget (Millions of USD)",
y = "Density"
) +
theme_minimal()
ggplot(Universal_budget_clean, aes(x = budget)) +
# Histogram of original production budgets
geom_histogram(
aes(y = after_stat(density)),
bins = 30,
fill = "skyblue",
colour = "black"
) +
# Fitted Exponential distribution
stat_function(
fun = dexp,
args = list(
rate = exponential_fit$estimate["rate"]
),
colour = "blue",
linewidth = 1.2
) +
labs(
title = "Universal Pictures Production Budgets",
subtitle = "Histogram with fitted Exponential distribution",
x = "Production Budget (USD)",
y = "Density"
) +
theme_minimal()
View(assignment_data)
